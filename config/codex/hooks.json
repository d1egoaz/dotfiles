{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay -v 15 /System/Library/Sounds/Hero.aiff >/dev/null 2>&1",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/files/agent-closeout-check\" codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
