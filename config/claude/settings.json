{
  "enabledPlugins": {
    "archie-cc@chime-claude-plugins": false,
    "infra@infra-skills": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_USE_BEDROCK": "false",
    "DISABLE_TELEMETRY": "1",
    "TFCTL_HOSTNAME": "tfe.hub.chmfin.com",
    "TFCTL_ORGANIZATION": "chime",
    "TFCTL_TELEMETRY": "disabled",
    "TFCTL_VCS_REPO": "github.com/1debit/chime-tf",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "infra-skills": {
      "source": {
        "repo": "1debit/infra-agent-skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "afplay -v 15 /System/Library/Sounds/Purr.aiff",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__tabs_close_mcp",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__gif_creator",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__resize_window",
      "mcp__claude-in-chrome__list_connected_browsers",
      "Bash(pbcopy:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws ec2 describe-:*)",
      "Bash(aws rds describe-:*)",
      "Bash(aws dynamodb describe-:*)",
      "Bash(aws dynamodb list-:*)",
      "Bash(aws cloudformation describe-:*)",
      "Bash(aws cloudformation list-:*)",
      "Bash(aws elbv2 describe-:*)",
      "Bash(aws autoscaling describe-:*)",
      "Bash(aws application-autoscaling describe-:*)",
      "Bash(aws route53 get-:*)",
      "Bash(aws route53 list-:*)",
      "Bash(aws acm describe-:*)",
      "Bash(aws acm list-:*)",
      "Bash(aws eks describe-:*)",
      "Bash(aws eks list-:*)",
      "Bash(aws ecs describe-:*)",
      "Bash(aws ecs list-:*)",
      "Bash(aws ecr describe-:*)",
      "Bash(aws ecr list-:*)",
      "Bash(aws elasticache describe-:*)",
      "Bash(aws cloudwatch describe-:*)",
      "Bash(aws cloudwatch list-:*)",
      "Bash(aws cloudwatch get-metric-statistics:*)",
      "Bash(aws cloudwatch get-metric-data:*)",
      "Bash(aws cloudwatch get-insight-rule-report:*)",
      "Bash(aws cloudwatch list-managed-insight-rules:*)",
      "Bash(aws logs describe-:*)",
      "Bash(aws logs filter-log-events:*)",
      "Bash(aws logs start-query:*)",
      "Bash(aws logs get-query-results:*)",
      "Bash(terraform version:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt -check:*)",
      "Bash(terraform workspace show:*)",
      "Bash(terraform graph:*)",
      "Bash(tfctl --help:*)",
      "Bash(tfctl --version:*)",
      "Bash(tfctl auth status:*)",
      "Bash(tfctl profile display:*)",
      "Bash(tfctl profile get:*)",
      "Bash(tfctl profile profiles list:*)",
      "Bash(tfctl api schema search:*)",
      "Bash(tfctl api schema get:*)",
      "Bash(tfctl get:*)",
      "Bash(tfctl run status:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ]
  },
  "showThinkingSummaries": true,
  "skillOverrides": {
    "chime-infra-change-evidence": "off",
    "chime-worktree-audit": "off",
    "git-history-orientation": "off",
    "scratch-log": "off",
    "chime-sourcegraph-search": "off",
    "infra:1password-op": "user-invocable-only",
    "infra:argo-rollouts-eso-bootstrap": "user-invocable-only",
    "infra:argocd-fleet-operations": "user-invocable-only",
    "infra:argocd-skipped-syncs": "user-invocable-only",
    "infra:aurora-migration": "user-invocable-only",
    "infra:aurora-mysql-blue-green": "user-invocable-only",
    "infra:aurora-parameter-group-rollout": "user-invocable-only",
    "infra:aws-lbc-upgrade": "user-invocable-only",
    "infra:aws-trace-path": "user-invocable-only",
    "infra:bedrock-model-checker": "user-invocable-only",
    "infra:bulk-approve-prs": "user-invocable-only",
    "infra:console-pod-db-access": "user-invocable-only",
    "infra:create-skill": "user-invocable-only",
    "infra:csc-domain-handoff": "user-invocable-only",
    "infra:datadog-dbm-secret": "user-invocable-only",
    "infra:datadog-vitals-check": "user-invocable-only",
    "infra:dsql-cluster-bootstrap": "user-invocable-only",
    "infra:dynamodb-capacity-mode-migration": "user-invocable-only",
    "infra:dynamodb": "user-invocable-only",
    "infra:eks-cluster-bootstrap": "user-invocable-only",
    "infra:eks-cluster-migration": "user-invocable-only",
    "infra:eks-version-upgrade": "user-invocable-only",
    "infra:eng-post-writer": "user-invocable-only",
    "infra:flashpaper": "user-invocable-only",
    "infra:github-webhook-enablement": "user-invocable-only",
    "infra:incident-review-notes": "user-invocable-only",
    "infra:infra-team-status": "user-invocable-only",
    "infra:jira": "user-invocable-only",
    "infra:lambda-from-docker": "user-invocable-only",
    "infra:network-client-debugging": "user-invocable-only",
    "infra:okta-aws-role-bootstrap": "user-invocable-only",
    "infra:pg-connection-killer": "user-invocable-only",
    "infra:pup": "user-invocable-only",
    "infra:rds-get-master-password": "user-invocable-only",
    "infra:s3-bucket-check": "user-invocable-only",
    "infra:sdm-db-check": "user-invocable-only",
    "infra:service-quotas": "user-invocable-only",
    "infra:terraform": "user-invocable-only",
    "infra:tfctl": "user-invocable-only",
    "infra:vector-cluster-onboarding": "user-invocable-only",
    "infra:vector-rollback": "user-invocable-only",
    "infra:wiz-eol-update": "user-invocable-only"
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "\uf1d1  Turning to the Dark Side \uf1d1 "
    ]
  },
  "statusLine": {
    "command": "~/code/oss/claude-status-line/target/release/statusline",
    "padding": 0,
    "type": "command"
  }
}
