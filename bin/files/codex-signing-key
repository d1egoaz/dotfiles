#!/usr/bin/env zsh
# Bootstrap and unlock the profile-specific OpenSSH Git signing key.
#
# This script never reads existing private-key material, overwrites a key, or
# registers a key with GitHub. It creates a new encrypted key interactively
# only when both expected paths are absent, then prints the registration command
# for the user to review and run separately.

set -euo pipefail

readonly agent_lifetime=86400
readonly ssh_dir="$HOME/.ssh"
readonly allowed_signers="$ssh_dir/allowed_signers"
readonly managed_allowed_signers="$ssh_dir/allowed_signers.managed"
readonly local_allowed_signers="$ssh_dir/allowed_signers.local"

usage() {
  cat <<'EOF'
Usage: codex-signing-key <bootstrap|unlock> --profile <office|personal>

bootstrap creates the selected encrypted Ed25519 signing key only when neither
its private nor public path exists, prints the GitHub signing-only registration
command, stores its passphrase in macOS Keychain, then loads the key into the
native ssh-agent for 24 hours.

unlock loads an existing encrypted profile key into the native ssh-agent for
24 hours and refreshes its macOS Keychain passphrase entry. It never enables
per-use confirmation.

Run this from the macOS login session after Home Manager activation. Office
~/work remotes retain HTTPS and use the existing GitHub credential helper.
Only explicitly selected SSH remotes use the configured 1Password IdentityAgent.
EOF
}

die() {
  print -u2 -r -- "codex-signing-key: $*"
  exit 1
}

[[ $# -ge 1 ]] || {
  usage >&2
  exit 2
}

command="$1"
shift

case "$command" in
  bootstrap|unlock)
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac

[[ $# -eq 2 && "$1" == "--profile" ]] || {
  usage >&2
  die "pass exactly --profile office or --profile personal"
}
profile="$2"

case "$profile" in
  office)
    private_key="$ssh_dir/codex-signing-office-ed25519"
    signing_principals=("info@diegoa.ca" "diego.alvarez@chime.com")
    ;;
  personal)
    private_key="$ssh_dir/codex-signing-personal-ed25519"
    signing_principals=("info@diegoa.ca")
    ;;
  *)
    die "unknown profile: $profile"
    ;;
esac
public_key="${private_key}.pub"

require_encrypted_key() {
  [[ -f "$private_key" && -f "$public_key" ]] || die "expected both $private_key and $public_key"

  # ssh-keygen accepts an empty passphrase only for an unencrypted private key.
  # Do not load a key until a non-empty passphrase has protected it at rest.
  if /usr/bin/ssh-keygen -y -P "" -f "$private_key" >/dev/null 2>&1; then
    die "refusing to load an unencrypted key; encrypt it with ssh-keygen -p -f $private_key"
  fi
}

enroll_allowed_signer() {
  [[ -f "$managed_allowed_signers" ]] || die "expected $managed_allowed_signers; run just switch before unlocking"

  local key_type key_data ignored principal signer_line
  read -r key_type key_data ignored < "$public_key" || die "could not read $public_key"
  [[ "$key_type" == "ssh-ed25519" && -n "$key_data" ]] || die "expected an Ed25519 public key at $public_key"

  local temporary_local_signers
  temporary_local_signers="$(mktemp "$ssh_dir/.allowed_signers.local.XXXXXX")" || die "could not prepare $local_allowed_signers"
  for principal in "${signing_principals[@]}"; do
    signer_line="$principal $key_type $key_data"
    print -r -- "$signer_line" >> "$temporary_local_signers"
  done
  chmod 600 "$temporary_local_signers"
  mv "$temporary_local_signers" "$local_allowed_signers"

  local temporary_allowed_signers
  temporary_allowed_signers="$(mktemp "$ssh_dir/.allowed_signers.XXXXXX")" || die "could not prepare $allowed_signers"
  cat "$managed_allowed_signers" > "$temporary_allowed_signers"
  printf '\n' >> "$temporary_allowed_signers"
  cat "$local_allowed_signers" >> "$temporary_allowed_signers"
  chmod 600 "$temporary_allowed_signers"
  mv "$temporary_allowed_signers" "$allowed_signers"
}

load_key() {
  [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] || die "no native SSH_AUTH_SOCK in this macOS login session; open a fresh terminal or restart Codex after activation"
  [[ "${SSH_AUTH_SOCK:l}" != *1password* ]] || die "SSH_AUTH_SOCK points to 1Password; open a fresh terminal or restart Codex after activation"

  # No -c constraint: one interactive unlock permits signing until this
  # explicit 24-hour lifetime expires, including while the screen is locked.
  /usr/bin/ssh-add --apple-use-keychain -t "$agent_lifetime" "$private_key"
}

case "$command" in
  bootstrap)
    if [[ -e "$private_key" || -L "$private_key" || -e "$public_key" || -L "$public_key" ]]; then
      die "refusing to overwrite existing key material at $private_key or $public_key"
    fi

    umask 077
    [[ -d "$ssh_dir" ]] || mkdir -m 700 "$ssh_dir"
    local_key_dir="$(mktemp -d "$ssh_dir/.codex-signing-key.XXXXXX")" || die "could not create a private temporary directory in $ssh_dir"
    temp_private="$local_key_dir/key"
    temp_public="${temp_private}.pub"
    cleanup_temporary_key() {
      rm -rf "$local_key_dir"
    }
    trap cleanup_temporary_key EXIT

    print -r -- "Create a non-empty passphrase when ssh-keygen prompts."
    /usr/bin/ssh-keygen -q -t ed25519 -a 100 -f "$temp_private" -C "codex-signing-$profile"
    private_key="$temp_private"
    public_key="$temp_public"
    require_encrypted_key
    private_key="$ssh_dir/codex-signing-${profile}-ed25519"
    public_key="${private_key}.pub"

    if [[ -e "$private_key" || -L "$private_key" || -e "$public_key" || -L "$public_key" ]]; then
      die "refusing to overwrite existing key material at $private_key or $public_key"
    fi
    mv "$temp_private" "$private_key"
    mv "$temp_public" "$public_key"
    trap - EXIT
    rmdir "$local_key_dir"

    print -r -- "Register this public key as GitHub signing-only after reviewing it:"
    print -r -- "  gh ssh-key add \"$public_key\" --type signing --title \"Codex signing ($profile)\""
    print -r -- "This script does not contact GitHub or register the key."
    enroll_allowed_signer
    load_key
    ;;
  unlock)
    require_encrypted_key
    enroll_allowed_signer
    load_key
    ;;
esac
