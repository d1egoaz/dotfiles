#!/usr/bin/env python3
"""Render Codex agent routing from the canonical TOML registry."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys
import tomllib
from collections.abc import Mapping


ROOT = pathlib.Path(__file__).resolve().parents[2]
REGISTRY_PATH = ROOT / "nix/data/agent-routing.toml"
CODEX_OUTPUT_ROOT = ROOT / "config/codex/agents/generated"
CLAUDE_OUTPUT_ROOT = ROOT / "config/claude/agents/generated"
MATRIX_OUTPUT = ROOT / "docs/agent-routing-matrix.md"
NIX_OUTPUT = ROOT / "nix/data/agent-routing.generated.nix"
ROUTING_REFERENCE = (
    ROOT
    / "config/agents/skills/multi-agent-team/task-coordinator/references/capability-routing.md"
)

EXPECTED_ROLES = {"explorer", "reviewer", "worker"}
EXPECTED_RUNTIMES = {"office_codex", "office_claude", "personal_home"}
# `neutral` runtimes keep model IDs independent of a particular client.
# Personal Codex consumes the home runtime through its local gateway.
PROVIDERS = {"codex", "claude", "neutral"}
# Claude Code has no sandbox_mode; read-only roles deny the file-editing tools.
CLAUDE_READ_ONLY_DISALLOWED = ("Edit", "Write", "NotebookEdit")
ROLE_ORDER = ("explorer", "worker", "reviewer")
EXPECTED_PROFILES = {"office", "personal"}
REQUIRED_TIERS = ("economy", "balanced", "frontier")
EXPECTED_CANONICAL_LAUNCHERS = {
    "spawn-subagent-explore": "explorer",
    "spawn-subagent-implement": "worker",
    "spawn-subagent-review": "reviewer",
}


class RoutingError(ValueError):
    """Raised when the registry cannot produce a safe, complete routing set."""


def fail(message: str) -> "NoReturn":
    raise RoutingError(message)


def read_registry() -> dict:
    try:
        with REGISTRY_PATH.open("rb") as registry_file:
            registry = tomllib.load(registry_file)
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot read {REGISTRY_PATH}: {error}")

    if registry.get("schema_version") != 1:
        fail("agent-routing.toml must declare schema_version = 1")
    if registry.get("tiers") != list(REQUIRED_TIERS):
        fail(f"tiers must be exactly {list(REQUIRED_TIERS)!r}")

    roles = registry.get("roles")
    if not isinstance(roles, Mapping) or set(roles) != EXPECTED_ROLES:
        fail(f"roles must be exactly {sorted(EXPECTED_ROLES)!r}")
    runtimes = registry.get("runtimes")
    if not isinstance(runtimes, Mapping) or set(runtimes) != EXPECTED_RUNTIMES:
        fail(f"runtimes must be exactly {sorted(EXPECTED_RUNTIMES)!r}")
    profiles = registry.get("profiles")
    if not isinstance(profiles, Mapping) or set(profiles) != EXPECTED_PROFILES:
        fail(f"profiles must be exactly {sorted(EXPECTED_PROFILES)!r}")

    for role_name, role in roles.items():
        if not isinstance(role, Mapping):
            fail(f"roles.{role_name} must be a table")
        for key in (
            "description",
            "tier",
            "effort",
            "sandbox_mode",
            "canonical_name",
            "capabilities",
            "developer_instructions",
        ):
            if key not in role:
                fail(f"roles.{role_name} is missing {key}")
        if role["tier"] not in REQUIRED_TIERS:
            fail(f"roles.{role_name}.tier is not a known tier")
        if role["effort"] not in registry["efforts"]:
            fail(f"roles.{role_name}.effort is not a known effort")
        if role["sandbox_mode"] not in {"read-only", "workspace-write"}:
            fail(f"roles.{role_name}.sandbox_mode is invalid")
        if role["canonical_name"] not in EXPECTED_CANONICAL_LAUNCHERS:
            fail(f"roles.{role_name}.canonical_name is invalid")
        if EXPECTED_CANONICAL_LAUNCHERS[role["canonical_name"]] != role_name:
            fail(f"roles.{role_name}.canonical_name maps to the wrong role")
        if not isinstance(role["capabilities"], list) or not role["capabilities"]:
            fail(f"roles.{role_name}.capabilities must be a non-empty list")
        if not isinstance(role.get("claude_omit_claude_md", False), bool):
            fail(f"roles.{role_name}.claude_omit_claude_md must be a boolean")

    canonical_names = [role["canonical_name"] for role in roles.values()]
    if len(set(canonical_names)) != len(canonical_names):
        fail("roles.canonical_name values must be unique")

    if "launchers" in registry:
        fail("launchers are not supported; unnamed spawns use the profile default route")

    for runtime_name, runtime in runtimes.items():
        if not isinstance(runtime, Mapping):
            fail(f"runtimes.{runtime_name} must be a table")
        if runtime.get("provider") not in PROVIDERS:
            fail(f"runtimes.{runtime_name}.provider is invalid")
        if runtime.get("lead_tier") not in REQUIRED_TIERS:
            fail(f"runtimes.{runtime_name}.lead_tier is invalid")
        if runtime.get("default_tier") not in REQUIRED_TIERS:
            fail(f"runtimes.{runtime_name}.default_tier is invalid")
        runtime_tiers = runtime.get("tiers")
        if not isinstance(runtime_tiers, Mapping) or set(runtime_tiers) != set(REQUIRED_TIERS):
            fail(f"runtimes.{runtime_name}.tiers must contain every routing tier")
        for tier in REQUIRED_TIERS:
            route = runtime_tiers[tier]
            if not isinstance(route, Mapping) or not route.get("model") or not route.get("label"):
                fail(f"runtimes.{runtime_name}.tiers.{tier} needs model and label")
            supported = route.get("supported_efforts")
            if not isinstance(supported, list):
                fail(f"runtimes.{runtime_name}.tiers.{tier}.supported_efforts must be a list")
            if "fallback_effort" in route:
                fail(f"Codex tier {runtime_name}.{tier} must not define fallback_effort")
            if not isinstance(route.get("verified", True), bool):
                fail(f"runtimes.{runtime_name}.tiers.{tier}.verified must be a boolean")
            if runtime.get("provider") == "claude" and not str(route.get("resolves_to", "")).startswith("claude-"):
                fail(f"runtimes.{runtime_name}.tiers.{tier} needs a claude-* resolves_to model ID")
        if not isinstance(runtime.get("opencode_go"), bool):
            fail(f"runtimes.{runtime_name}.opencode_go must be a boolean")
    for profile_name, profile in profiles.items():
        if not isinstance(profile, Mapping):
            fail(f"profiles.{profile_name} must be a table")
        for key in (
            "codex_runtime",
            "codex_lead_tier",
            "codex_lead_effort",
            "codex_default_tier",
            "codex_default_effort",
            "pi_runtime",
            "pi_tier",
            "pi_effort",
        ):
            if key not in profile:
                fail(f"profiles.{profile_name} is missing {key}")
        for runtime_key in ("codex_runtime", "pi_runtime"):
            if profile[runtime_key] not in EXPECTED_RUNTIMES:
                fail(f"profiles.{profile_name}.{runtime_key} is unknown")
        codex_runtime = runtimes[profile["codex_runtime"]]
        if codex_runtime["provider"] == "neutral":
            if profile.get("home_runtime") != profile["codex_runtime"]:
                fail(f"profiles.{profile_name}.codex_runtime must use the profile home_runtime")
            if not codex_runtime["opencode_go"]:
                fail(f"profiles.{profile_name}.codex_runtime must use the local gateway")
        elif codex_runtime["provider"] != "codex":
            fail(f"profiles.{profile_name}.codex_runtime must use the codex provider")
        if runtimes[profile["pi_runtime"]]["provider"] != "codex":
            fail(f"profiles.{profile_name}.pi_runtime must use the codex provider")
        claude_runtime = profile.get("claude_runtime")
        if claude_runtime is not None:
            if claude_runtime not in EXPECTED_RUNTIMES:
                fail(f"profiles.{profile_name}.claude_runtime is unknown")
            if runtimes[claude_runtime]["provider"] != "claude":
                fail(f"profiles.{profile_name}.claude_runtime must use the claude provider")
            if profile.get("claude_lead_effort") not in registry["efforts"]:
                fail(f"profiles.{profile_name}.claude_lead_effort is invalid")
        home_runtime = profile.get("home_runtime")
        if home_runtime is not None:
            if home_runtime not in EXPECTED_RUNTIMES:
                fail(f"profiles.{profile_name}.home_runtime is unknown")
            if runtimes[home_runtime]["provider"] != "neutral":
                fail(f"profiles.{profile_name}.home_runtime must use the neutral provider")
            for effort_key in ("home_lead_effort", "home_default_effort"):
                if profile.get(effort_key) not in registry["efforts"]:
                    fail(f"profiles.{profile_name}.{effort_key} is invalid")
        for tier_key in ("codex_lead_tier", "codex_default_tier", "pi_tier"):
            if profile[tier_key] not in REQUIRED_TIERS:
                fail(f"profiles.{profile_name}.{tier_key} is invalid")
        for effort_key in (
            "codex_lead_effort",
            "codex_default_effort",
            "pi_effort",
        ):
            if profile[effort_key] not in registry["efforts"]:
                fail(f"profiles.{profile_name}.{effort_key} is invalid")

    return registry


def runtime_slug(runtime_name: str) -> str:
    return runtime_name.replace("_", "-")


def route(registry: Mapping, runtime_name: str, tier: str) -> Mapping:
    return registry["runtimes"][runtime_name]["tiers"][tier]


def effective_effort(runtime: Mapping, tier: str, requested: str) -> str:
    selected = runtime["tiers"][tier]
    if requested not in selected["supported_efforts"]:
        fail(f"Codex route {tier} does not support requested effort {requested}")
    return requested


def native_launcher_instructions(extra: str) -> str:
    return (
        "This configuration is a native-subagent launcher. Use it only through "
        "the native subagent spawn control, never as a visible child task. "
        "Return results or blockers only to the parent lead.\n\n"
        f"{extra}"
    )


def render_codex_agent(registry: Mapping, runtime_name: str, role_name: str) -> str:
    role = registry["roles"][role_name]
    runtime = registry["runtimes"][runtime_name]
    selected = route(registry, runtime_name, role["tier"])
    effort = effective_effort(runtime, role["tier"], role["effort"])
    return (
        f'name = {json.dumps(role["canonical_name"])}\n'
        f'description = {json.dumps(role["description"])}\n'
        f'model = {json.dumps(selected["model"])}\n'
        f'model_reasoning_effort = {json.dumps(effort)}\n'
        f'sandbox_mode = {json.dumps(role["sandbox_mode"])}\n'
        f'developer_instructions = """\n{native_launcher_instructions(role["developer_instructions"].strip())}\n"""\n'
    )


def render_claude_agent(registry: Mapping, runtime_name: str, role_name: str) -> str:
    role = registry["roles"][role_name]
    runtime = registry["runtimes"][runtime_name]
    selected = route(registry, runtime_name, role["tier"])
    effort = effective_effort(runtime, role["tier"], role["effort"])
    lines = [
        "---",
        f"name: {role['canonical_name']}",
        f"description: {json.dumps(role['description'])}",
        f"model: {selected['model']}",
        f"effort: {effort}",
    ]
    if role["sandbox_mode"] == "read-only":
        lines.append(f"disallowedTools: {', '.join(CLAUDE_READ_ONLY_DISALLOWED)}")
    if role.get("claude_omit_claude_md"):
        lines.append("omitClaudeMd: true")
    lines.extend(["---", "", role["developer_instructions"].strip(), ""])
    return "\n".join(lines)


def claude_runtime_for(registry: Mapping, profile_name: str) -> str | None:
    return registry["profiles"][profile_name].get("claude_runtime")


def nix_key(key: str) -> str:
    if key.replace("_", "").isalnum() and key and not key[0].isdigit():
        return key
    return json.dumps(key)


def nix_value(value: object, indent: int = 0) -> list[str]:
    pad = " " * indent
    if isinstance(value, bool):
        return ["true" if value else "false"]
    if isinstance(value, (int, float)):
        return [str(value)]
    if isinstance(value, str):
        return [json.dumps(value)]
    if isinstance(value, list):
        if not value:
            return ["[ ]"]
        return ["[ " + " ".join(nix_value(item)[0] for item in value) + " ]"]
    if isinstance(value, Mapping):
        lines = ["{"]
        for key in sorted(value):
            child = nix_value(value[key], indent + 2)
            if len(child) == 1:
                lines.append(f"{pad}  {nix_key(str(key))} = {child[0]};")
            else:
                lines.append(f"{pad}  {nix_key(str(key))} = {child[0]}")
                lines.extend(child[1:-1])
                lines.append(f"{pad}  {child[-1]};")
        lines.append(f"{pad}}}")
        return lines
    fail(f"cannot render Nix value {value!r}")


def render_nix(registry: Mapping) -> str:
    runtimes: dict = {}
    for runtime_name in sorted(registry["runtimes"]):
        runtime = registry["runtimes"][runtime_name]
        tiers = {}
        for tier in REQUIRED_TIERS:
            selected = route(registry, runtime_name, tier)
            tiers[tier] = {
                "effective_efforts": selected["supported_efforts"],
                "label": selected["label"],
                "model": selected["model"],
            }
            if "fallback_effort" in selected:
                tiers[tier]["fallback_effort"] = selected["fallback_effort"]
        runtimes[runtime_name] = {
            "default_tier": runtime["default_tier"],
            "display_name": runtime["display_name"],
            "opencode_go": runtime["opencode_go"],
            "provider": runtime["provider"],
            "tiers": tiers,
        }

    profiles: dict = {}
    for profile_name in sorted(registry["profiles"]):
        profile = registry["profiles"][profile_name]
        codex_runtime = profile["codex_runtime"]
        codex_lead = route(registry, codex_runtime, profile["codex_lead_tier"])
        codex_default = route(registry, codex_runtime, profile["codex_default_tier"])
        pi = route(registry, profile["pi_runtime"], profile["pi_tier"])
        profiles[profile_name] = {
            "codex": {
                "agent_directory": profile_name,
                "default": {
                    "effort": effective_effort(
                        registry["runtimes"][codex_runtime],
                        profile["codex_default_tier"],
                        profile["codex_default_effort"],
                    ),
                    "label": codex_default["label"],
                    "model": codex_default["model"],
                    "runtime": runtime_slug(codex_runtime),
                    "tier": profile["codex_default_tier"],
                },
                "lead": {
                    "effort": effective_effort(
                        registry["runtimes"][codex_runtime],
                        profile["codex_lead_tier"],
                        profile["codex_lead_effort"],
                    ),
                    "label": codex_lead["label"],
                    "model": codex_lead["model"],
                    "runtime": runtime_slug(codex_runtime),
                    "tier": profile["codex_lead_tier"],
                },
                "opencode_go": registry["runtimes"][codex_runtime]["opencode_go"],
            },
            **(
                {
                    "claude": {
                        "agent_directory": profile_name,
                        "agents": [
                            registry["roles"][role_name]["canonical_name"]
                            for role_name in ROLE_ORDER
                        ],
                        "runtime": runtime_slug(profile["claude_runtime"]),
                    }
                }
                if profile.get("claude_runtime")
                else {}
            ),
            "pi": {
                "effort": effective_effort(
                    registry["runtimes"][profile["pi_runtime"]],
                    profile["pi_tier"],
                    profile["pi_effort"],
                ),
                "label": pi["label"],
                "model": pi["model"],
                "provider": "openai-codex",
                "runtime": runtime_slug(profile["pi_runtime"]),
                "tier": profile["pi_tier"],
            },
        }

    document = {
        "profiles": profiles,
        "runtimes": runtimes,
        "schema_version": registry["schema_version"],
    }
    return "# Generated by bin/files/agent-routing-generate. Do not edit.\n" + "\n".join(
        nix_value(document)
    ) + "\n"


def render_reference(registry: Mapping) -> str:
    lines = [
        "# Capability routing",
        "",
        "Generated from `nix/data/agent-routing.toml` by `agent-routing-generate`.",
        "Pick a role by what the work may touch; the registry resolves its tier,",
        "model, and effort for the active runtime. Never promote a blocked route",
        "to a more expensive tier.",
        "",
        "## Tiers",
        "",
        "| Tier | Use when |",
        "|---|---|",
        "| `economy` | Bounded, objectively checkable work. |",
        "| `balanced` | Exploration, synthesis, or correctness review. |",
        "| `frontier` | The lead: deep ambiguity and integration judgment. |",
        "",
        "## Native-subagent roles",
        "",
    ]
    for role_name in ("explorer", "worker", "reviewer"):
        role = registry["roles"][role_name]
        lines.append(
            f"- `@{role['canonical_name']}` -> `{role['tier']}`, `{role['effort']}`, "
            f"`{role['sandbox_mode']}`: {role['description']}"
        )
    lines.extend(
        [
            "",
            "An unnamed spawn uses the profile default route (`economy`) and inherits",
            "the parent sandbox; use it for a bounded batch of procedural commands.",
            "",
            "## How many agents",
            "",
            "- A lookup or one-step check stays in the lead.",
            "- Independent reads fan out, one explorer per unit (service, repo, area).",
            "- Each write set gets exactly one implementer; never run parallel writers on shared files.",
            "- Review is one independent pass before publication.",
            "",
            "## Naming",
            "",
            "Spawned instances use `<key>_<tier>_<model-label>_<effort-code>_<role>_<slice>`;",
            "visible task titles use `<state-prefix> [<key>] <tier>-<model-label>-<effort-code> <action> <object>`.",
            "The `task-coordinator` skill defines the allowed visible-task status prefixes.",
            "",
            "## Gates",
            "",
            "- Reclassify a materially different follow-up instead of inheriting its route.",
            "- Authentication, access, approval, or tool failure is blocked, not escalation.",
            "- Never repeat a side-effectful action as a routing retry; reconstruct state and authority first.",
            "- High consequence alone does not select a premium tier.",
        ]
    )
    return "\n".join(lines) + "\n"


def matrix_cell(registry: Mapping, runtime_name: str, tier: str, effort: str) -> str:
    runtime = registry["runtimes"][runtime_name]
    selected = route(registry, runtime_name, tier)
    model = f"`{selected['model']}`"
    if "resolves_to" in selected:
        model += f" (`{selected['resolves_to']}`)"
    if selected.get("verified") is False:
        model += " (unverified)"
    return f"{model} / {effective_effort(runtime, tier, effort)}"


def render_matrix(registry: Mapping) -> str:
    roles = registry["roles"]
    header = ["Harness", "Lead"]
    header += [f"`{roles[name]['canonical_name']}`" for name in ROLE_ORDER]
    header.append("Unnamed spawn")
    lines = [
        "# Agent routing matrix",
        "",
        "Generated from `nix/data/agent-routing.toml` by `agent-routing-generate`;",
        "do not edit. Each cell is the harness model value and requested effort.",
        "",
        "Roles: "
        + ", ".join(
            f"`{roles[name]['canonical_name']}` ({roles[name]['sandbox_mode']}, "
            f"{roles[name]['tier']})"
            for name in ROLE_ORDER
        )
        + ".",
    ]
    for profile_name in sorted(registry["profiles"]):
        profile = registry["profiles"][profile_name]
        lines.extend(
            [
                "",
                f"## {profile_name}",
                "",
                "| " + " | ".join(header) + " |",
                "|" + "---|" * len(header),
            ]
        )
        codex_runtime = profile["codex_runtime"]
        row = [
            f"Codex ({registry['runtimes'][codex_runtime]['display_name']})",
            matrix_cell(registry, codex_runtime, profile["codex_lead_tier"], profile["codex_lead_effort"]),
        ]
        row += [
            matrix_cell(registry, codex_runtime, roles[name]["tier"], roles[name]["effort"])
            for name in ROLE_ORDER
        ]
        row.append(
            matrix_cell(
                registry,
                codex_runtime,
                profile["codex_default_tier"],
                profile["codex_default_effort"],
            )
        )
        lines.append("| " + " | ".join(row) + " |")
        claude_runtime = profile.get("claude_runtime")
        if claude_runtime:
            row = [
                f"Claude Code ({registry['runtimes'][claude_runtime]['display_name']})",
                matrix_cell(
                    registry,
                    claude_runtime,
                    registry["runtimes"][claude_runtime]["lead_tier"],
                    profile["claude_lead_effort"],
                ),
            ]
            row += [
                matrix_cell(registry, claude_runtime, roles[name]["tier"], roles[name]["effort"])
                for name in ROLE_ORDER
            ]
            default = route(registry, claude_runtime, registry["runtimes"][claude_runtime]["default_tier"])
            row.append(f"`{default['model']}` (`{default['resolves_to']}`) / session effort")
            lines.append("| " + " | ".join(row) + " |")
        home_runtime = profile.get("home_runtime")
        if home_runtime and home_runtime != codex_runtime:
            home = registry["runtimes"][home_runtime]
            row = [
                home["display_name"],
                matrix_cell(registry, home_runtime, home["lead_tier"], profile["home_lead_effort"]),
            ]
            row += [
                matrix_cell(registry, home_runtime, roles[name]["tier"], roles[name]["effort"])
                for name in ROLE_ORDER
            ]
            row.append(
                matrix_cell(registry, home_runtime, home["default_tier"], profile["home_default_effort"])
            )
            lines.append("| " + " | ".join(row) + " |")
    if any(profile.get("claude_runtime") for profile in registry["profiles"].values()):
        lines.extend(
            [
                "",
                "## Claude Code notes",
                "",
                "- `config/claude/settings.json` sets the lead (`model`, `effortLevel`), pins each",
                "  alias to its model ID (`ANTHROPIC_DEFAULT_<ALIAS>_MODEL`), sets the unnamed-spawn model",
                "  (`CLAUDE_CODE_SUBAGENT_MODEL`), turns off nesting",
                "  (`CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1`, like Codex `max_depth = 1`),",
                "  and denies the built-in `Explore` so `spawn-subagent-explore` is the only explorer.",
                "- Read-only roles deny `Edit`, `Write`, and `NotebookEdit` but keep `Bash`,",
                "  and `permissionMode` is ignored while the lead runs in auto mode. Read-only",
                "  is enforced by instructions and permission review, not by a sandbox as in Codex.",
            ]
        )
    if any(profile.get("home_runtime") for profile in registry["profiles"].values()):
        lines.extend(
            [
                "",
                "## Home tier notes",
                "",
                "- Home tiers belong to the `personal` profile only; office machines never use them.",
                "- Personal Codex consumes them through the local gateway.",
                "- Bare model IDs route through OpenCode Go; vendor-prefixed IDs route through",
                "  OpenRouter.",
            ]
        )
    return "\n".join(lines) + "\n"


def build_outputs(registry: Mapping) -> dict[pathlib.Path, str]:
    outputs: dict[pathlib.Path, str] = {
        NIX_OUTPUT: render_nix(registry),
        ROUTING_REFERENCE: render_reference(registry),
        MATRIX_OUTPUT: render_matrix(registry),
    }
    for profile_name in sorted(EXPECTED_PROFILES):
        runtime_name = registry["profiles"][profile_name]["codex_runtime"]
        for role_name in sorted(EXPECTED_ROLES):
            canonical_name = registry["roles"][role_name]["canonical_name"]
            outputs[
                CODEX_OUTPUT_ROOT / profile_name / f"{canonical_name}.toml"
            ] = render_codex_agent(registry, runtime_name, role_name)
        claude_runtime = claude_runtime_for(registry, profile_name)
        if claude_runtime:
            for role_name in sorted(EXPECTED_ROLES):
                canonical_name = registry["roles"][role_name]["canonical_name"]
                outputs[
                    CLAUDE_OUTPUT_ROOT / profile_name / f"{canonical_name}.md"
                ] = render_claude_agent(registry, claude_runtime, role_name)
    return outputs


def generated_files() -> set[pathlib.Path]:
    paths = {NIX_OUTPUT, ROUTING_REFERENCE, MATRIX_OUTPUT}
    for profile_name in EXPECTED_PROFILES:
        paths.update((CODEX_OUTPUT_ROOT / profile_name).glob("*.toml"))
        paths.update((CLAUDE_OUTPUT_ROOT / profile_name).glob("*.md"))
    return paths


def check_outputs(outputs: Mapping[pathlib.Path, str]) -> list[str]:
    errors = []
    expected_paths = set(outputs)
    for path, expected in outputs.items():
        try:
            actual = path.read_text()
        except OSError:
            errors.append(f"missing generated output: {path.relative_to(ROOT)}")
            continue
        if actual != expected:
            errors.append(f"generated output drift: {path.relative_to(ROOT)}")
    for path in sorted(generated_files() - expected_paths):
        errors.append(f"unexpected generated output: {path.relative_to(ROOT)}")
    return errors


def write_outputs(outputs: Mapping[pathlib.Path, str]) -> None:
    # These are dedicated generated directories. Only files in those exact
    # directories are removed, so hand-edited source and user state remain safe.
    for directory in [CODEX_OUTPUT_ROOT / profile for profile in EXPECTED_PROFILES]:
        directory.mkdir(parents=True, exist_ok=True)
    for path in generated_files() - set(outputs):
        if path.exists():
            path.unlink()
    for path, content in outputs.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="check generated output without writing")
    args = parser.parse_args()
    try:
        outputs = build_outputs(read_registry())
        errors = check_outputs(outputs)
        if args.check:
            if errors:
                for error in errors:
                    print(error, file=sys.stderr)
                return 1
            print(f"agent routing outputs are current ({len(outputs)} files)")
            return 0
        write_outputs(outputs)
        print(f"generated agent routing outputs ({len(outputs)} files)")
        return 0
    except RoutingError as error:
        print(f"agent-routing: {error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"agent-routing: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
