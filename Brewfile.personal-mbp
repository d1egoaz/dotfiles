# -*- mode: ruby; -*-

tap "nikitabobko/tap" # Tap for AeroSpace window manager

brew "tailscale" # WireGuard-based mesh VPN
brew "opencode"

cask "aerospace" # Window manager
cask "chatgpt" # ChatGPT desktop client
cask "cloudflare-warp"
cask "codex-app"
cask "discord" # Community chat/voice
cask "excalidrawz" # Excalidraw whiteboard
cask "grandperspective" # Graphically shows disk usage within a file system
cask "little-snitch" # Network firewall/monitor
cask "mouseless@preview"
cask "protonvpn" # VPN client
cask "plex" # Media server app
cask "plexamp" # Music player focusing on visuals
cask "zoom" # Video conferencing
cask "1password" # Password manager
